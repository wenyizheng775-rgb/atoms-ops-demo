# DeepSeek API（必填，仅服务端；勿提交真实 Key）
DEEPSEEK_API_KEY=sk-your-key-here

# 可选，默认 deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# LLM 超时毫秒，默认 90000
DEEPSEEK_TIMEOUT_MS=90000

# 每 IP 每分钟 generate 次数，默认 8
RATE_LIMIT_GENERATE=8

# 运维看板 SLO 发布阈值（百分比），默认 99
GATE_SLO_MIN=99

# QQ 邮箱 SMTP（注册验证码；SMTP_PASS 填授权码，不是登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-qq@qq.com
SMTP_PASS=your-smtp-auth-code
SMTP_FROM=Atoms Ops Demo <your-qq@qq.com>
